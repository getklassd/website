<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GetKlassd.Cms</RootNamespace>
    <!--
      All Blazor components live in the Klassd.Backoffice RCL, so this host has no .razor
      files of its own. Without that, the SDK leaves RequiresAspNetWebAssets=false and never
      pulls in the framework's _framework/blazor.web.js static asset → 404 at runtime.
      Force it on so the Blazor admin script is served. (See Microsoft.NET.Sdk.Web.ProjectSystem.targets.)
    -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <!--
    Pre-1.0 we dogfood Klassd against live source via the `klassd` git submodule.
    Flip these to <PackageReference Include="Klassd.*" /> once published to NuGet.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\klassd\src\Klassd.Backoffice\Klassd.Backoffice.csproj" />
    <ProjectReference Include="..\..\klassd\src\Klassd.Data.Sqlite\Klassd.Data.Sqlite.csproj" />
    <ProjectReference Include="..\..\klassd\src\Klassd.Cache.InMemory\Klassd.Cache.InMemory.csproj" />
    <ProjectReference Include="..\..\klassd\src\Klassd.Media.FileSystem\Klassd.Media.FileSystem.csproj" />
  </ItemGroup>

</Project>
